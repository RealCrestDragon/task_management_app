// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts" 
}

datasource db {
  provider = "postgresql"
}

model User{
  id  Int @id @default(autoincrement())
  username  String @unique
  email  String @unique
  password  String
  fullName  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  tasks Task[]
  subtasks Subtask[]
  tasksAssignedBy TaskAssignment[] @relation("TaskAssignedBy")
  tasksAssignedTo TaskAssignment[] @relation("TaskAssignedTo")
  subtasksAssignedBy SubtaskAssignment[] @relation("SubtaskAssignedBy")
  subtasksAssignedTo SubtaskAssignment[] @relation("SubtaskAssignedTo")
  notifications Notification[]
}

model Task{
  id  Int @id @default(autoincrement())
  name  String
  content  String?
  authorId  Int
  dueDate DateTime?
  status TaskStatus @default(ACTIVE)
  isPinned  Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  author  User @relation(fields: [authorId], references: [id] )
  subtasks Subtask[]
  taskAssignments  TaskAssignment[]
  taskTags TaskTag[]
  notifications Notification[]
}

model Subtask{
  id  Int @id @default(autoincrement())
  name  String
  content  String?
  taskId  Int
  authorId  Int
  dueDate DateTime?
  status TaskStatus   @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  author  User @relation(fields: [authorId], references: [id] )
  task  Task @relation(fields: [taskId], onDelete: Cascade, references: [id] )
  subtaskAssignments  SubtaskAssignment[]
  notifications Notification[]
}

model Tag{
  id  Int @id @default(autoincrement())
  name  String
  description  String?
  color  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  taskTags TaskTag[]
}

model TaskAssignment{
  id  Int @id @default(autoincrement())
  taskId  Int
  assignedById  Int
  assignedToId  Int
  role  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  assignedBy  User @relation("TaskAssignedBy", fields: [assignedById], onDelete: Cascade, references: [id] )
  assignedTo  User @relation("TaskAssignedTo", fields: [assignedToId], onDelete: Cascade, references: [id] )
  task  Task @relation(fields: [taskId], onDelete: Cascade, references: [id] )
}

model SubtaskAssignment{
  id  Int @id @default(autoincrement())
  subtaskId  Int
  assignedById  Int
  assignedToId  Int
  role  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  assignedBy  User @relation("SubtaskAssignedBy", fields: [assignedById], onDelete: Cascade, references: [id] )
  assignedTo  User @relation("SubtaskAssignedTo", fields: [assignedToId], onDelete: Cascade, references: [id] )
  subtask  Subtask @relation(fields: [subtaskId], onDelete: Cascade, references: [id] )
}

model TaskTag{
  id  Int @id @default(autoincrement())
  taskId  Int
  tagId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  task  Task @relation(fields: [taskId], references: [id] )
  tag  Tag @relation(fields: [tagId], references: [id] )
}
model Notification{
  id  Int @id @default(autoincrement())
  userId  Int
  title  String
  taskId    Int?
  subtaskId   Int?
  content   String?
  type      NotificationType
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user  User @relation(fields: [userId], references: [id] )
  task      Task?    @relation(fields: [taskId], references: [id])
  subtask   Subtask? @relation(fields: [subtaskId], references: [id])
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  ARCHIVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REMINDER
  SUBTASK_ASSIGNED
  SUBTASK_REMINDER
}

